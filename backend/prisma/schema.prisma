// Schema do portfólio. Toda alteração exige uma migration (prisma migrate dev).
// O client é gerado em ../generated/prisma e versionado de propósito: a imagem
// de produção não roda `prisma generate`.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

model Admin {
  id           BigInt  @id @default(autoincrement())
  email        String  @unique
  name         String?
  password     String
  // Incrementado no logout: invalida todos os JWTs emitidos antes.
  tokenVersion Int     @default(0)

  projeto  Projeto[]
  subtitle Subtitle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Projeto {
  id        BigInt @id @default(autoincrement())
  nome      String
  descricao String @db.Text
  link      String @db.VarChar(2048)

  adminId BigInt
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  tecnologias ProjetoTecnologia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projetos")
}

model Subtitle {
  id       BigInt @id @default(autoincrement())
  subtitle String @db.Text

  adminId BigInt
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subtitles")
}

model Tecnologia {
  id   BigInt @id @default(autoincrement())
  nome String @unique

  projetos ProjetoTecnologia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tecnologias")
}

model ProjetoTecnologia {
  projetoId    BigInt
  tecnologiaId BigInt

  projeto    Projeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  tecnologia Tecnologia @relation(fields: [tecnologiaId], references: [id], onDelete: Cascade)

  @@id([projetoId, tecnologiaId])
  @@map("projeto_tecnologias")
}
