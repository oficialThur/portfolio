# Copie para .env.prod e preencha os valores reais antes de subir em produção.
# Exemplo: cp .env.prod.example .env.prod

# Frontend permitido no CORS (separe por virgula)
ALLOWED_ORIGINS=https://seu-projeto.vercel.app,https://www.seudominio.com

# SMTP (exemplo para Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_SECURE=tls
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM=seu_email@gmail.com
SMTP_FROM_NAME=Portfolio Contact

# Rate limit do endpoint de contato
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=5
RATE_LIMIT_MIN=15
