# ---------------------------------------------------------------------------
# Copie este arquivo para env/.env e preencha os valores reais.
# Produção (docker-compose.prod.yml) exige este arquivo; no dev ele é opcional
# (docker-compose.dev.yml tem defaults de root/root e porta 3308).
# ---------------------------------------------------------------------------

# Banco — credenciais usadas pelo Prisma adapter em runtime
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_USER=portfolio
DATABASE_PASSWORD=troque-esta-senha
DATABASE_NAME=portfolio_db

# URL usada pela CLI do Prisma (migrate/seed).
# Nos containers o host é o nome do serviço (db). Rodando a CLI na máquina,
# use localhost com a porta publicada pelo compose dev:
#   DATABASE_URL="mysql://root:root@localhost:3308/portfolio_db"
DATABASE_URL="mysql://portfolio:troque-esta-senha@db:3306/portfolio_db"

# Container MySQL — devem casar com DATABASE_USER/PASSWORD/NAME acima.
# MYSQL_USER não pode ser "root".
MYSQL_ROOT_PASSWORD=troque-a-senha-root
MYSQL_DATABASE=portfolio_db
MYSQL_USER=portfolio
MYSQL_PASSWORD=troque-esta-senha

# Sessão — gere uma chave aleatória longa (ex.: openssl rand -hex 32)
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Cookie de sessão: use true somente quando o site for servido via HTTPS.
# Em HTTP puro (inclusive atrás de um proxy sem TLS) deixe false, senão o
# navegador descarta o cookie e o login não persiste.
COOKIE_SECURE=false

# Contato (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app

# Seed do admin (usado ao rodar prisma/seed.js)
ADMIN_NAME=Arthur
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# Frontend — só usado ao rodar o Vite na máquina (fora do Docker)
VITE_API_URL=http://localhost:3001
